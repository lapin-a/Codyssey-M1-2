# OpenAI
OPENAI_API_KEY=sk-...
# OpenAI 호환 프록시를 쓸 때만 지정 (예: https://.../v1)
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_TOKENS=2000

# Firebase: 서비스 계정 JSON 전체를 한 줄 문자열로 넣거나, 파일 경로를 지정
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# CORS 허용 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app
